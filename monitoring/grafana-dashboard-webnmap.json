        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * sum(rate(http_requests_total{status!~\"2..\", endpoint=~\"$endpoint\", source_id=~\"$source_id\", variable_group=~\"$variable_group\", query_group=~\"$query_group\"}[5m])) / clamp_min(sum(rate(http_requests_total{endpoint=~\"$endpoint\", source_id=~\"$source_id\", variable_group=~\"$variable_group\", query_group=~\"$query_group\"}[5m])), 1e-9)",
          "legendFormat": "error %",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Error Rate (5m)",
      "type": "stat"
    },
