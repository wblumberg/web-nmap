          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (endpoint, source_id, variable_group) (rate(http_requests_total{method=\"GET\", endpoint=~\"$endpoint\", source_id=~\"$source_id\", variable_group=~\"$variable_group\", query_group=~\"$query_group\"}[5m]))",
          "legendFormat": "{{endpoint}} | {{source_id}} | {{variable_group}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "RPS by Endpoint",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
