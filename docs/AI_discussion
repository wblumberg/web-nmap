//
// Structure:
//   PRODUCT_SUITES[id] = {
//     label,          — display name
//     group,          — logical group (like mod_res.tbl's group column: 'basic', 'instability', etc.)
//     data_sources,   — which DATA_SOURCES entries this needs
//     available_for,  — which model/source IDs this suite can be used with
//     make_layers,    — async function(loadedData, grid) → { layers, colorbar, sampler }
//   }

