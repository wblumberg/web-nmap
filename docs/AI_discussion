                ticks: [-40, -20, 0, 20, 40, 60, 80, 100, 120]
            });
            return {
                layers: [
                    new apgl.PlotLayer('t2m_fill', fill),
                    new apgl.PlotLayer('t2m_32f',  cntr),
                ],
                colorbar: [svg],
                sampler: (lon, lat) => ({ 't2m': field.sampleField(lon, lat) }),
