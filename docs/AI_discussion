## Updated `DataLoader.js` — Zarr + Compressed JSON

This is the major forward-looking change. The loader becomes format-aware. Zarr handles gridded data; compressed JSON handles point/obs data. The rest of the system doesn't care which format is in use — that's entirely encapsulated here.

```javascript name=src/DataLoader.js
// Runtime data loader.
// Supports two formats going forward:
//   - Zarr (gridded / raster data)         — via zarr.js / zarrita
//   - Compressed JSON (point / obs data)   — gzip'd JSON, decoded client-side
//
// Legacy binary (.bin.gz) is also supported during transition.

import * as zarr from 'zarr';            // https://github.com/gzuidhof/zarr.js
// OR: import * as zarrita from 'zarrita'; // https://github.com/manzt/zarrita.js

import DATA_SOURCES from './config/datasources.js';

// ─── Zarr loader ────────────────────────────────────────────────────────────
async function loadZarrVariable(storeUrl, variablePath) {
    // storeUrl: URL to the zarr store root (e.g. 'data/gfs.2025030200.zarr')
    // variablePath: path within the store (e.g. 'hgt_500mb')
    const store = new zarr.HTTPStore(storeUrl);
    const arr   = await zarr.openArray({ store, path: variablePath, mode: 'r' });
    const raw   = await arr.getRaw();           // returns a TypedArray (Float32/Int16/etc.)
    return new Float32Array(raw.data.buffer);   // normalize to Float32 for autumnplot-gl
}

async function loadZarrStore(storeUrl, variableNames) {
    // Load multiple variables from one zarr store in parallel
    const results = await Promise.all(
        variableNames.map(async v => [v, await loadZarrVariable(storeUrl, v)])
    );
    return Object.fromEntries(results);
}

// ─── Compressed JSON loader ──────────────────────────────────────────────────
async function loadCompressedJSON(url) {
    const resp      = await fetch(url);
    const buffer    = await resp.arrayBuffer();
    const bytes     = new Uint8Array(buffer);
    const inflated  = pako.inflate(bytes, { to: 'string' });  // pako decompresses gzip
    return JSON.parse(inflated);
}

// ─── Legacy binary loader (kept for transition period) ──────────────────────
async function loadBinaryGz(url, dtype = 'float16') {
    const resp     = await fetch(url);
    const bytes    = new Uint8Array(await (await resp.blob()).arrayBuffer());
    const inflated = pako.inflate(bytes);
    if (dtype === 'uint8')   return inflated;
    return new float16.Float16Array(new Float32Array(inflated.buffer));
}

// ─── Main entry point ────────────────────────────────────────────────────────
/**
 * Load all data variables required by a product suite.
 *
 * @param {string}   sourceId   - Key into DATA_SOURCES (e.g. 'GFS')
 * @param {string[]} dataKeys   - Logical variable names (e.g. ['hght_500mb', 'ugrd_500mb'])
 * @param {object}   timeParams - { cycle, fhr, valid_time }
 * @param {object}   varMap     - Maps logical key → store path (e.g. { hght_500mb: 'hgt_500mb' })
 * @returns {object}            - { key: TypedArray | object[] }
 */
async function loadData(sourceId, dataKeys, timeParams, varMap = {}) {
    const src = DATA_SOURCES[sourceId];
    if (!src) throw new Error(`Unknown data source: ${sourceId}`);

    const result = {};

    if (src.format === 'zarr') {
        // Resolve store URL from template
        const storeUrl = resolveTemplate(src.url_template, timeParams);
        // Map logical keys to zarr variable paths
        const storeVars = dataKeys.map(k => varMap[k] ?? k);
        const loaded    = await loadZarrStore(storeUrl, storeVars);
        // Re-key back to logical names
        dataKeys.forEach((k, i) => { result[k] = loaded[storeVars[i]]; });

    } else if (src.format === 'compressed_json') {
        for (const key of dataKeys) {
            const url      = resolveTemplate(src.url_template, { ...timeParams, variable: varMap[key] ?? key });
            result[key]    = await loadCompressedJSON(url);
        }

    } else if (src.format === 'binary_gz') {
        // Legacy path — kept during transition
        for (const key of dataKeys) {
            const url   = resolveTemplate(src.url_template, { ...timeParams, variable: varMap[key] ?? key });
            let   data  = await loadBinaryGz(url, src.dtype);
            if (src.wrap_lon) data = applyLonWrap(data, src.grid());
            result[key] = data;
        }
    }

    return result;
}

// ─── Helpers ─────────────────────────────────────────────────────────────────
function resolveTemplate(template, params) {
    return template
        .replace('{cycle}',      params.cycle      ?? '')
        .replace('{fhr}',        String(params.fhr ?? '').padStart(3, '0'))
        .replace('{valid_time}', params.valid_time ?? '')
        .replace('{variable}',   params.variable   ?? '');
}

function applyLonWrap(data, grid) {
    const padded = new float16.Float16Array(grid.ni * grid.nj);
    for (let j = 0; j < grid.nj; j++) {
        const s = (grid.ni - 1) * j;
        const p = grid.ni * j;
        padded.set(data.subarray(s, s + grid.ni - 1), p);
        padded[p + grid.ni - 1] = data[s];
    }
    return padded;
}

export { loadData };
```

