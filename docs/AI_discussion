### 4. `src/DataLoader.js` — runtime data fetching

This separates the **fetch-and-decode** logic (currently duplicated in each `makeXxxLayers()` function) from the visualization logic.

```javascript name=src/DataLoader.js
// Handles all data fetching and decoding.
// Knows about the wrap_lon quirk for global grids, dtype decoding, etc.

import DATA_SOURCES from './datasources.js';

async function fetchBinary(url, dtype = 'float16') {
    const resp = await fetch(url);
    const ary  = new Uint8Array(await (await resp.blob()).arrayBuffer());
    const inflated = pako.inflate(ary);
    if (dtype === 'uint8') return inflated;
    return new float16.Float16Array(new Float32Array(inflated.buffer));
}

async function fetchJSON(url) {
    return (await fetch(url)).json();
}

/**
 * Resolve and load all data_keys required by a product suite for a given
 * data source + time, returning a plain { key: TypedArray } object.
 *
 * @param {string} sourceId     - Key into DATA_SOURCES
 * @param {string[]} dataKeys   - Logical variable names needed by the product
 * @param {object} timeParams   - { cycle, fhr, valid_time }
 * @param {object} varMap       - Maps logical data_keys to file URL fragments
 *                                e.g. { t2m: 'tmp_2m', hght_500mb: 'hgt_500mb' }
 */
async function loadData(sourceId, dataKeys, timeParams, varMap = {}) {
    const src = DATA_SOURCES[sourceId];
    if (!src) throw new Error(`Unknown data source: ${sourceId}`);

    const result = {};

    for (const key of dataKeys) {
        const fragment = varMap[key] ?? key;
        const url = src.url_template
            .replace('{cycle}',      timeParams.cycle      ?? '')
            .replace('{fhr}',        String(timeParams.fhr ?? '').padStart(3, '0'))
            .replace('{valid_time}', timeParams.valid_time ?? '')
            .replace('{variable}',   fragment);

        if (src.dtype === 'json') {
            result[key] = await fetchJSON(url);
        } else {
            let data = await fetchBinary(url, src.dtype);
            // Handle global grid longitude wrapping (GFS-style)
            if (src.wrap_lon) {
                const grid = src.grid();
                const padded = new float16.Float16Array(grid.ni * grid.nj);
                for (let j = 0; j < grid.nj; j++) {
                    const s = (grid.ni - 1) * j;
                    const p = grid.ni * j;
                    padded.set(data.subarray(s, s + grid.ni - 1), p);
                    padded[p + grid.ni - 1] = data[s];
                }
                data = padded;
            }
            result[key] = data;
        }
    }

    return result;
}

export { loadData };
```

