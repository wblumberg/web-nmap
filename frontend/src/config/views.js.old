    // ════════════════════════════════════════════════════════════════════════
    // GROUP: point  (observations)
    // ════════════════════════════════════════════════════════════════════════

    'surface_obs_standard': {
        label:         'Surface Obs — Standard Model',
        group:         'point',
        source_id:     'SURFACE_OBS',
        product_id:    'surface_obs_standard',
        maxZoom:       8.5,
        time:          { valid_time: '20250302_1800' },
        // Point products don't use a grid; var_map maps the data_key
        // to the JSON file URL template variable
        var_map:       { obs_json: '' },
        async makeLayers() {
            const data  = await loadData(
                this.source_id,
                PRODUCT_SUITES[this.product_id].data_keys,
                this.time,
                this.var_map
            );
            // Point products receive null for grid
            return PRODUCT_SUITES[this.product_id].make_layers(data, null);
        },
    },

    'surface_obs_dewpoint': {
        label:         'Surface Obs — Dewpoint Model',
        group:         'point',
        source_id:     'SURFACE_OBS',
        product_id:    'surface_obs_dewpoint',  // a different station model from point.js
        maxZoom:       8.5,
        time:          { valid_time: '20250302_1800' },
        var_map:       { obs_json: '' },
        async makeLayers() {
            const data = await loadData(
                this.source_id,
                PRODUCT_SUITES[this.product_id].data_keys,
                this.time,
                this.var_map
            );
            return PRODUCT_SUITES[this.product_id].make_layers(data, null);
        },
    },
};

// ─── Query helpers ────────────────────────────────────────────────────────────
// These are used by the UI (main.js) to build grouped menus and drive
// time-stepping controls. main.js never needs to read the raw registry directly.

/**
 * Returns all views in a given group, sorted by label.
 * Used by the UI to build the grouped dropdown or tabbed selector.
 *
 * @param {string} group - e.g. 'basic', 'instability'
 * @returns {{ id: string, label: string }[]}
 */
export function getViewsByGroup(group) {
    return Object.entries(VIEW_REGISTRY)
        .filter(([, v]) => v.group === group)
        .map(([id, v]) => ({ id, label: v.label }))
        .sort((a, b) => a.label.localeCompare(b.label));
}

/**
 * Returns all views available for a specific data source.
 * Useful for building a "what can I see for GFS right now?" selector.
 *
 * @param {string} sourceId - e.g. 'GFS', 'HRRR'
 * @returns {{ id: string, label: string, group: string }[]}
 */
export function getViewsForSource(sourceId) {
    return Object.entries(VIEW_REGISTRY)
        .filter(([, v]) => v.source_id === sourceId)
        .map(([id, v]) => ({ id, label: v.label, group: v.group }))
        .sort((a, b) => a.group.localeCompare(b.group) || a.label.localeCompare(b.label));
}

/**
 * Returns the available forecast hours for a view, or [] if not applicable.
 * Used to configure the time-step slider/buttons in the UI.
 *
 * @param {string} viewId - key into VIEW_REGISTRY
 * @returns {number[]}
 */
export function getAvailableFhrs(viewId) {
    return VIEW_REGISTRY[viewId]?.available_fhrs ?? [];
}

/**
 * Updates the active forecast hour for a view and returns a new makeLayers
 * function bound to the new time. Leaves the registry entry's `time` object
 * mutated (suitable for single-panel use; clone if you need multi-panel).
 *
 * @param {string} viewId - key into VIEW_REGISTRY
 * @param {number} fhr    - forecast hour to activate
 */
export function setViewFhr(viewId, fhr) {
    const view = VIEW_REGISTRY[viewId];
    if (!view) throw new Error(`Unknown view: ${viewId}`);
    if (!view.available_fhrs?.includes(fhr))
        throw new Error(`fhr ${fhr} not available for view ${viewId}`);
    view.time = { ...view.time, fhr };
}

/**
 * Returns all groups that have at least one registered view,
 * sorted by the order defined in VIEW_GROUPS.
 * Used to build the group tabs/headers in the UI.
 *
 * @returns {{ id: string, label: string }[]}
 */
export function getActiveGroups() {
    const usedGroups = new Set(Object.values(VIEW_REGISTRY).map(v => v.group));
    return Object.entries(VIEW_GROUPS)
        .filter(([id]) => usedGroups.has(id))
        .sort(([, a], [, b]) => a.order - b.order)
        .map(([id, meta]) => ({ id, label: meta.label }));
}
