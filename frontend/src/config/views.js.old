/**
 * views.js — The web-NMAP View Registry
 *
 * Analogous to NMAP2's mod_res.tbl, this file is the central registry of
 * everything the user can select and display. It answers three questions:
 *
 *   1. What data source does this view use?         (source_id → datasources.js)
 *   2. What product/visualization does it use?      (product_id → products/)
 *   3. What time parameters does it carry?          (time + available_fhrs)
 *
 * It does NOT contain rendering code (that's in products/)
 * It does NOT contain fetch code (that's in DataLoader.js)
 *
 * Structure of a View entry:
 * {
 *   label       : string       — display name shown in the UI dropdown
 *   group       : string       — logical group (drives UI grouping/tabs)
 *   source_id   : string|null  — key into DATA_SOURCES (null = synthetic/no fetch)
 *   product_id  : string       — key into PRODUCT_SUITES
 *   maxZoom     : number       — map max zoom level for this view
 *   time        : object       — current time parameters { cycle, fhr, valid_time }
 *   var_map     : object       — maps product data_keys → actual store variable names
 *   available_fhrs: number[]   — forecast hours available for time stepping (if applicable)
 * }
 */

import DATA_SOURCES   from './datasources.js';
import PRODUCT_SUITES from '../products/index.js';
import { loadData }   from '../DataLoader.js';

// ─── Group metadata ──────────────────────────────────────────────────────────
// Defines the display order and labels for the UI group selectors.
// Analogous to the group-name column in mod_res.tbl.
export const VIEW_GROUPS = {
    'synthetic':     { label: 'Synthetic / Demo',        order: 0 },
    'basic':         { label: 'Basic Fields',            order: 1 },
    'instability':   { label: 'Instability',             order: 2 },
    'moisture':      { label: 'Moisture',                order: 3 },
    'lift':          { label: 'Lift Indices',            order: 4 },
    'shear':         { label: 'Shear / Kinematics',      order: 5 },
    'precipitation': { label: 'Precipitation',           order: 6 },
    'composite':     { label: 'Ensemble / Composite',    order: 7 },
    'raster':        { label: 'Raster / Imagery',        order: 8 },
    'point':         { label: 'Observations',            order: 9 },
};

// ─── Helper: build a makeLayers() function from source + product + time ──────
//
// This is the glue layer. It reads source_id → DataLoader → ProductSuite.
// Every gridded view uses this pattern; special cases (synthetic, point) override it.
//
function makeGriddedLayersFn(viewDef) {
    return async function() {
        const src    = DATA_SOURCES[viewDef.source_id];
        const suite  = PRODUCT_SUITES[viewDef.product_id];

        if (!src)   throw new Error(`Unknown data source: ${viewDef.source_id}`);
        if (!suite) throw new Error(`Unknown product suite: ${viewDef.product_id}`);

        const data = await loadData(
            viewDef.source_id,
            suite.data_keys,
            viewDef.time,
            viewDef.var_map ?? {}
        );

        const grid = src.grid();
        return suite.make_layers(data, grid);
    };
}

// ─── The View Registry ───────────────────────────────────────────────────────
export const VIEW_REGISTRY = {

    // ════════════════════════════════════════════════════════════════════════
    // GROUP: synthetic  (no data files needed — for demo / development)
    // ════════════════════════════════════════════════════════════════════════

    'synthetic_500mb': {
        label:       'Synthetic 500mb (Demo)',
        group:       'synthetic',
        source_id:   null,          // no data fetch
        product_id:  'synthetic_500mb',
        maxZoom:     7,
        time:        {},
        // Synthetic views call make_layers directly with no data
        makeLayers() {
            return PRODUCT_SUITES['synthetic_500mb'].make_layers({}, null);
        },
    },

    // ════════════════════════════════════════════════════════════════════════
    // GROUP: basic
    // ════════════════════════════════════════════════════════════════════════

    'gfs_t2m': {
        label:         'GFS — 2m Temperature',
        group:         'basic',
        source_id:     'GFS',
        product_id:    'sfc_temp_fill',
        maxZoom:       7,
        available_fhrs: [0, 6, 12, 18, 24, 30, 36, 42, 48],
        time:          { cycle: '2025030200', fhr: 0 },
        // Maps product's logical data_key names → zarr variable paths in the GFS store
        var_map:       { t2m: 'tmp_2m' },
        get makeLayers() { return makeGriddedLayersFn(this); },
    },

    'nam_t2m': {
        label:         'NAM — 2m Temperature',
        group:         'basic',
        source_id:     'NAM',
        product_id:    'sfc_temp_fill',
        maxZoom:       7,
