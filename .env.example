# Copy this file to .env and fill in real values.
# .env is listed in .gitignore and must never be committed.

# SQLAlchemy async DSN for TimescaleDB/PostGIS
# Format: postgresql+asyncpg://user:password@host:port/dbname
TIMESCALE_CONN=postgresql+asyncpg://webnmap:CHANGE_ME@localhost:5432/wxdata

# KNMI scatterometer FTP. Running ``python -m
# backend.api.ingest.ascat_ingest`` with no paths downloads ASCAT-B/C directly.
ASCAT_FTP_HOST=ftppro.knmi.nl
ASCAT_FTP_USERNAME=CHANGE_ME
ASCAT_FTP_PASSWORD=CHANGE_ME
ASCAT_FTP_MAX_RECENT=20
ASCAT_FTP_STATE=ascat_ftp_state.json
# ASCAT_FTP_TLS=false

# FAA SWIM/ASDI streaming client
FAA_SWIM_RUN_CMD=/home/gblumberg/ingest/faa_swim/bin/run
FAA_SWIM_CONFIG=/home/gblumberg/ingest/faa_swim/application.conf
FAA_SWIM_LINE_LIMIT_MB=16
# Optional destructive ingest filter. Leave unset to retain every aircraft.
# FAA_ASDI_CARRIERS=major
